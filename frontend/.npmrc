# Recipe-only frontend: we deliberately do NOT commit a lockfile.
# Dependencies are declared with sparse (caret) ranges in package.json, and a
# fresh `npm install` resolves current, compatible versions each time. This keeps
# deps from rotting into old/insecure versions.
package-lock=false

# Supply-chain cooldown: never install a version published in the last 7 days
# (a freshly-published release is the classic compromised-package vector).
# This is the `min-release-age` config (unit: days), added in npm 11.10.0 — it
# is silently ignored by older npm, so this only takes effect on npm >= 11.10.0.
min-release-age=7
